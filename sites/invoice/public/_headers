# Cloudflare Pages headers. CSP allows only self plus the two Cloudflare Web
# Analytics origins (beacon added at launch — drop them if analytics changes).
# frame-src blob: exists solely for the print button (hidden iframe with the
# generated PDF blob → browser print dialog); blob: URLs are same-origin.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; frame-src 'self' blob:; base-uri 'self'; frame-ancestors 'self'

# Vite emits content-hashed filenames under /assets/ — cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
