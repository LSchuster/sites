---
// The one page of the site: static shell + SEO content rendered by Astro,
// the React generator mounts client-side into #root (see src/main.tsx).
//
// Cloudflare Web Analytics (cookie-less): enable at launch by adding
//   <script defer src="https://static.cloudflareinsights.com/beacon.min.js"
//     data-cf-beacon='{"token": "TOKEN"}' is:inline></script>
// before </body>; the CSP in public/_headers already allows it.
import '../styles.css';
import '../landing.css';
import { t } from '../i18n';

const faqs = [
  {
    q: 'Ist der Rechnungsgenerator wirklich kostenlos?',
    a: 'Ja. Alle Funktionen — PDF-Erzeugung, E-Rechnung (ZUGFeRD), Vorlagen für Kleinunternehmer und Reverse Charge — sind kostenlos und ohne Anmeldung nutzbar. Es gibt keine Premium-Version und keine versteckten Kosten.',
  },
  {
    q: 'Was ist eine E-Rechnung (ZUGFeRD/Factur-X)?',
    a: 'Eine E-Rechnung ist ein strukturierter Datensatz nach der EU-Norm EN 16931. ZUGFeRD/Factur-X ist ein Hybridformat: eine normale PDF-Datei, in die die maschinenlesbaren Rechnungsdaten als XML eingebettet sind. Dieses Werkzeug erzeugt beides in einem einzigen Dokument (PDF/A-3, Profil EN 16931).',
  },
  {
    q: 'Wer muss ab wann E-Rechnungen ausstellen?',
    a: 'Seit dem 1. Januar 2025 müssen alle deutschen Unternehmen E-Rechnungen im B2B-Bereich empfangen können. Ab 2027 wird das Ausstellen für Unternehmen mit mehr als 800.000 € Vorjahresumsatz Pflicht, ab 2028 für alle. Wer jetzt schon ZUGFeRD-Rechnungen verschickt, ist auf der sicheren Seite.',
  },
  {
    q: 'Wohin werden meine Rechnungsdaten übertragen?',
    a: 'Nirgendwohin. Die gesamte Rechnung — PDF und XML — wird von Ihrem Browser auf Ihrem Gerät erzeugt. Es gibt keinen Server, kein Konto und keine Cloud. Gespeicherte Profile liegen ausschließlich im lokalen Speicher Ihres Browsers.',
  },
  {
    q: 'Kann ich Rechnungen auf Englisch schreiben?',
    a: 'Ja. Die Sprache des Rechnungsdokuments ist pro Rechnung wählbar (Deutsch oder Englisch), z. B. für Kunden im Ausland — inklusive korrekter Reverse-Charge-Hinweise.',
  },
];

const schemaApp = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Rechnung schreiben — kostenloser Rechnungsgenerator mit E-Rechnung',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  featureList:
    'PDF-Rechnung, E-Rechnung (ZUGFeRD/Factur-X EN 16931), XRechnung, § 19 UStG Kleinunternehmer, Reverse Charge § 13b, DIN 5008, deutsch/englisch',
  browserRequirements: 'Requires JavaScript',
};

const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const features = [
  {
    title: 'E-Rechnung inklusive',
    text: 'Jede PDF ist zugleich eine gültige E-Rechnung: PDF/A-3 mit eingebettetem ZUGFeRD/Factur-X-XML im Profil EN 16931 — akzeptiert von Buchhaltungssoftware und Behördenvalidatoren.',
    icon: 'file',
  },
  {
    title: 'XRechnung für Behörden',
    text: 'Rechnungen an öffentliche Auftraggeber (B2G) als XRechnung — reines XML mit Leitweg-ID, bereit für die Einreichung über ZRE und OZG-RE.',
    icon: 'landmark',
  },
  {
    title: '§ 14 UStG automatisch geprüft',
    text: 'Das Formular prüft alle Pflichtangaben nach § 14 Abs. 4 UStG und blockiert den Download, solange etwas fehlt — unvollständige Rechnungen gehen gar nicht erst raus.',
    icon: 'shield',
  },
  {
    title: 'Alle Umsatzsteuer-Fälle',
    text: 'Regelbesteuerung, Kleinunternehmer (§ 19), Reverse Charge (§ 13b), innergemeinschaftliche Lieferung und Ausfuhr — jeweils mit dem korrekten Pflichthinweis auf der Rechnung.',
    icon: 'percent',
  },
  {
    title: 'Professionelles Briefbild',
    text: 'DIN 5008 Form B mit eigenem Logo und Live-Vorschau während der Eingabe. Die Dokumentsprache ist pro Rechnung wählbar: Deutsch oder Englisch.',
    icon: 'layout',
  },
  {
    title: 'Ihre Daten bleiben bei Ihnen',
    text: 'Kein Server, kein Konto, keine Cloud: Profile und gespeicherte Empfänger liegen nur im Browser (localStorage) — mit Export und Import als JSON-Backup.',
    icon: 'lock',
  },
];

const steps = [
  {
    title: 'Angaben eintragen',
    text: 'Eigene Angaben und Empfänger erfassen — beim nächsten Besuch vorausgefüllt. Alles bleibt lokal in Ihrem Browser.',
  },
  {
    title: 'Positionen & Steuerfall wählen',
    text: 'Positionen erfassen und den Umsatzsteuer-Fall festlegen: Regelbesteuerung, § 19 UStG, Reverse Charge, innergemeinschaftliche Lieferung oder Ausfuhr.',
  },
  {
    title: 'Herunterladen',
    text: 'Sie erhalten eine PDF-Rechnung im DIN-5008-Layout, die zugleich eine gültige E-Rechnung ist (ZUGFeRD/Factur-X, Profil EN 16931) — oder eine XRechnung als XML.',
  },
];

const pflicht = [
  'vollständiger Name und Anschrift von Rechnungssteller und Empfänger',
  'Steuernummer oder Umsatzsteuer-Identifikationsnummer des Ausstellers',
  'Ausstellungsdatum und eine fortlaufende, einmalige Rechnungsnummer',
  'Menge und Art der Lieferung bzw. Umfang und Art der Leistung',
  'Zeitpunkt der Lieferung oder Leistung (bzw. Leistungszeitraum)',
  'nach Steuersätzen aufgeschlüsseltes Entgelt, Steuersatz und Steuerbetrag — oder ein Hinweis auf die Steuerbefreiung',
];
---

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Rechnung schreiben kostenlos — mit E-Rechnung (ZUGFeRD)</title>
    <meta
      name="description"
      content="Kostenlos Rechnungen schreiben — als PDF und E-Rechnung (ZUGFeRD/Factur-X, EN 16931) in einem Dokument. Läuft komplett im Browser: keine Anmeldung, keine Cloud, Ihre Daten verlassen Ihr Gerät nicht."
    />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://invoice.teespoon.io/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://invoice.teespoon.io/" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content="Rechnung schreiben kostenlos — mit E-Rechnung (ZUGFeRD)" />
    <meta
      property="og:description"
      content="PDF + E-Rechnung (ZUGFeRD/Factur-X, EN 16931) in einem Dokument, komplett im Browser. Keine Anmeldung, keine Cloud."
    />
    <script type="application/ld+json" set:html={JSON.stringify(schemaApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(schemaFaq)} />
    <!-- Blocking on purpose: applies the stored theme before first paint. -->
    <script src="/theme-init.js" is:inline></script>
  </head>

  <body>
    <a class="skip-link" href="#generator">Zum Rechnungsformular springen</a>

    <header class="topbar">
      <div class="wrap topbar-inner">
        <a class="brand" href="#top" aria-label="Rechnung schreiben — Startseite">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
              <path d="M14 2v6h6"></path>
              <path d="M8 13h5M8 17h8"></path>
            </svg>
          </span>
          <span class="brand-name">Rechnung schreiben</span>
          <span class="brand-badge">kostenlos</span>
        </a>
        <nav class="topnav" aria-label="Seitennavigation">
          <a href="#generator">Generator</a>
          <a href="#funktionen">Funktionen</a>
          <a href="#e-rechnung-pflicht">E-Rechnung-Pflicht</a>
          <a href="#faq">FAQ</a>
        </nav>
        <button type="button" class="ghost theme-toggle" id="theme-toggle">
          <span class="tt-icon" aria-hidden="true"></span>
          <span class="tt-label"></span>
        </button>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="wrap hero-inner">
          <p class="hero-eyebrow">
            <span class="hero-eyebrow-dot" aria-hidden="true"></span>
            ZUGFeRD · Factur-X · XRechnung — Profil EN&nbsp;16931
          </p>
          <h1>
            Rechnung schreiben —<br />
            <span class="grad">kostenlos, mit E-Rechnung.</span>
          </h1>
          <p class="lede">{t.tagline}</p>
          <div class="hero-cta">
            <a class="btn-primary" href="#generator">Jetzt Rechnung erstellen</a>
            <a class="btn-ghost" href="#funktionen">Alle Funktionen ansehen</a>
          </div>
          <ul class="trust-row" role="list">
            <li>100&nbsp;% kostenlos</li>
            <li>Keine Anmeldung</li>
            <li>Daten bleiben im Browser</li>
            <li>§&nbsp;14 UStG-Prüfung eingebaut</li>
          </ul>
        </div>
      </section>

      <section class="app-section" id="generator" aria-label="Rechnungsgenerator">
        <div class="wrap">
          <div id="root">
            <div class="app-loading" aria-hidden="true">
              <div class="app-loading-bar"></div>
              <p>Rechnungsformular wird geladen …</p>
            </div>
          </div>
          <noscript>
            <p class="noscript-note">
              Dieser kostenlose Rechnungsgenerator läuft vollständig in Ihrem Browser und
              benötigt JavaScript. Es werden keine Daten an einen Server übertragen.
            </p>
          </noscript>
        </div>
      </section>

      <section class="band" id="funktionen">
        <div class="wrap">
          <h2>Alles drin, was eine Rechnung braucht</h2>
          <p class="band-lede">
            Vom Briefbild bis zum eingebetteten XML: ein Werkzeug für Freiberufler und
            kleine Unternehmen — ohne Konto, ohne Cloud, ohne Kosten.
          </p>
          <div class="feature-grid">
            {features.map((f) => (
              <article class="feature-card">
                <span class={`feature-icon icon-${f.icon}`} aria-hidden="true">
                  {f.icon === 'file' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
                      <path d="M14 2v6h6"></path>
                      <path d="m10 12.5-2 2 2 2"></path>
                      <path d="m14 12.5 2 2-2 2"></path>
                    </svg>
                  )}
                  {f.icon === 'landmark' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 21h18"></path>
                      <path d="M5 17.5V10M9.5 17.5V10M14.5 17.5V10M19 17.5V10"></path>
                      <path d="m12 2.5 9.5 5h-19Z"></path>
                    </svg>
                  )}
                  {f.icon === 'shield' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s8-3.6 8-9.8V5.2L12 2 4 5.2v7C4 18.4 12 22 12 22Z"></path>
                      <path d="m9 11.6 2.2 2.2L15.5 9.5"></path>
                    </svg>
                  )}
                  {f.icon === 'percent' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M19 5 5 19"></path>
                      <circle cx="6.8" cy="6.8" r="2.6"></circle>
                      <circle cx="17.2" cy="17.2" r="2.6"></circle>
                    </svg>
                  )}
                  {f.icon === 'layout' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                      <path d="M3 9.5h18"></path>
                      <path d="M9.5 21V9.5"></path>
                    </svg>
                  )}
                  {f.icon === 'lock' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="4" y="11" width="16" height="10" rx="2"></rect>
                      <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
                    </svg>
                  )}
                </span>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="band band-alt" id="ablauf">
        <div class="wrap">
          <h2>In drei Schritten zur fertigen Rechnung</h2>
          <ol class="steps" role="list">
            {steps.map((s, i) => (
              <li class="step">
                <span class="step-no" aria-hidden="true">{i + 1}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="band" id="e-rechnung-pflicht">
        <div class="wrap band-cols">
          <div>
            <h2>E-Rechnung-Pflicht: der Zeitplan</h2>
            <ol class="timeline" role="list">
              <li>
                <span class="tl-date">Seit 1. Januar 2025</span>
                <p>
                  Alle Unternehmen in Deutschland müssen E-Rechnungen im B2B-Geschäft
                  <em> empfangen</em> können. Eine einfache PDF gilt nicht mehr als E-Rechnung.
                </p>
              </li>
              <li>
                <span class="tl-date">Ab 1. Januar 2027</span>
                <p>
                  Unternehmen mit mehr als 800.000&nbsp;€ Vorjahresumsatz müssen
                  B2B-Rechnungen als E-Rechnung <em>ausstellen</em>.
                </p>
              </li>
              <li>
                <span class="tl-date">Ab 1. Januar 2028</span>
                <p>Die Ausstellungspflicht gilt für alle Unternehmen.</p>
              </li>
            </ol>
            <p class="band-note">
              Dieses Werkzeug erzeugt schon heute das Hybridformat ZUGFeRD/Factur-X im
              Profil EN&nbsp;16931: eine menschenlesbare PDF, in der die maschinenlesbaren
              Daten als XML eingebettet sind — akzeptiert von Buchhaltungssoftware und
              Behördenvalidatoren.
            </p>
          </div>
          <aside class="highlight-card">
            <h2>Kleinunternehmerregelung (§&nbsp;19 UStG)</h2>
            <p>
              Kleinunternehmer weisen keine Umsatzsteuer aus, müssen ihre Rechnung aber mit
              einem Hinweis auf §&nbsp;19 UStG versehen. Wählen Sie einfach den
              Umsatzsteuer-Fall „Kleinunternehmer“ — der Pflichthinweis wird automatisch auf
              der Rechnung und in den strukturierten E-Rechnungs-Daten ergänzt, und die
              Positionen werden ohne Steuer berechnet.
            </p>
          </aside>
        </div>
      </section>

      <section class="band band-alt" id="pflichtangaben">
        <div class="wrap wrap-narrow">
          <h2>Pflichtangaben einer Rechnung (§&nbsp;14 UStG)</h2>
          <p class="band-lede">Jede Rechnung an Unternehmer muss nach §&nbsp;14 Abs.&nbsp;4 UStG enthalten:</p>
          <ul class="checklist" role="list">
            {pflicht.map((item) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5"></path>
                </svg>
                {item}
              </li>
            ))}
          </ul>
          <p class="band-note">
            Das Formular prüft diese Angaben automatisch und blockiert den Download,
            solange etwas fehlt.
          </p>
        </div>
      </section>

      <section class="band" id="faq">
        <div class="wrap wrap-narrow">
          <h2>Häufige Fragen</h2>
          <div class="faq-list">
            {faqs.map(({ q, a }) => (
              <details class="faq-item">
                <summary>{q}</summary>
                <p>{a}</p>
              </details>
            ))}
          </div>
          <p class="disclaimer">
            Dieses Werkzeug bietet keine Steuer- oder Rechtsberatung. Prüfen Sie Rechnungen
            vor dem Versand; im Zweifel fragen Sie Ihre Steuerberatung.
          </p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <span class="brand-name">Rechnung schreiben</span>
          <p>{t.footerPrivacy}</p>
          <p>{t.footerDisclaimer}</p>
        </div>
        <nav class="footer-links" aria-label="Rechtliches">
          <a href="/impressum.html">Impressum</a>
          <a href="/datenschutz.html">Datenschutz</a>
        </nav>
      </div>
    </footer>

    <script>
      // Theme toggle in the static topbar; cycles System → Dunkel → Hell
      // (same behaviour the old React ThemeToggle had).
      import { t } from '../i18n';
      import type { Theme } from '../theme';
      import { setTheme, storedTheme } from '../theme';

      const ORDER: Theme[] = ['system', 'dark', 'light'];
      const LABEL: Record<Theme, string> = {
        system: t.themeSystem,
        dark: t.themeDark,
        light: t.themeLight,
      };
      const ICON: Record<Theme, string> = { system: '◐', dark: '●', light: '○' };

      const btn = document.getElementById('theme-toggle');
      if (btn instanceof HTMLButtonElement) {
        let current = storedTheme();
        const render = () => {
          const icon = btn.querySelector('.tt-icon');
          const label = btn.querySelector('.tt-label');
          if (icon) icon.textContent = ICON[current];
          if (label) label.textContent = LABEL[current];
        };
        btn.title = t.themeTitle;
        btn.addEventListener('click', () => {
          current = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length] ?? 'system';
          setTheme(current);
          render();
        });
        render();
      }
    </script>
    <script>
      // React generator app (separate chunk — the toggle above stays snappy).
      import '../main';
    </script>
  </body>
</html>
